# Unity project lives in "Zombie shooting/".
# IMPORTANT: .meta files, Packages/ and ProjectSettings/ MUST be committed —
# without them every asset gets a new GUID on clone and all scene references break.

# Unity-generated folders (rebuilt automatically)
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# Unity crash-recovery scene copies
**/Assets/_Recovery/
**/Assets/_Recovery.meta

# IDE / generated project files
.vs/
.vscode/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Build artifacts
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# OS
.DS_Store
Thumbs.db
desktop.ini
